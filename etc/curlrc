# ~/.curlrc

# follow redirects, cap them
location
max-redirs = 10

# timeouts + retries
connect-timeout = 10
max-time = 90
retry = 3
retry-delay = 1
retry-max-time = 60

# quiet, but still tell me when something fails
silent
show-error

# security
proto = "=https,http"
proto-redir = "=https"
tlsv1.2
ciphers = "HIGH:!aNULL:!eNULL:!EXPORT:!DES:!RC4:!MD5:!PSK:!SRP:!CAMELLIA"

# performance
compressed
http2  
tcp-nodelay

# cookies / auth
cookie-jar = "~/.curl-cookies"
netrc-optional
