# =============================================================================
# --------------------------------- prompt ------------------------------------
# =============================================================================
# --- palette: swap the active host block per machine ---
_PROMPT_FG="#ffffff"
# ---- localhost ----
_PROMPT_HOST="#085041"; _PROMPT_PATH="#5f5e5a"; _PROMPT_GIT="#ba7517"; _PROMPT_DIRTY="#ba7517"
# ---- vps-bureau ----
# _PROMPT_HOST="#185fa5"; _PROMPT_PATH="#5f5e5a"; _PROMPT_GIT="#3b6d11"; _PROMPT_DIRTY="#c19c00"
# ---- vps-cyber ----
# _PROMPT_HOST="#993c1d"; _PROMPT_PATH="#5f5e5a"; _PROMPT_GIT="#3b6d11"; _PROMPT_DIRTY="#d4537e"
# ---- vps-fidacura ----
# _PROMPT_HOST="#534ab7"; _PROMPT_PATH="#5f5e5a"; _PROMPT_GIT="#1d9e75"; _PROMPT_DIRTY="#d4537e"

_PROMPT_VENV="#5a4a86"     # python venv
_PROMPT_OK="#5fff00"       # success arrow
_PROMPT_ERR="#ff0000"      # error arrow / exit code
_PROMPT_MUTED="#888780"    # duration + simple prompt text

# --- glyphs (real chars so copy-paste can't drop them) ---
_PL=$'\ue0b0'            # powerline chevron
_IC_FOLDER=$'\uf07b'     # folder (currently unused; available)
_IC_BRANCH=$'\ue725'     # git branch
_IC_PYTHON=$'\ue73c'     # python
_IC_TIMER=$'\uf252'      # hourglass

parse_git_branch() { git branch 2>/dev/null | grep '^\*' | sed 's/\* //'; }

# --- path: full if shallow, ~/…/last-two if deeper than 4 ---
_prompt_pwd() { print -rn -- "${(%):-%(4~|~/…/%2~|%~)}"; }

# --- timing + exit status ---
preexec() { _PROMPT_START=$SECONDS }
precmd() {
  _PROMPT_STATUS=$?
  if [[ -n "$_PROMPT_START" ]]; then
    _PROMPT_DUR=$(( SECONDS - _PROMPT_START )); unset _PROMPT_START
  else
    _PROMPT_DUR=0
  fi
}

# --- top line: powerline segments chained so chevrons blend ---
_prompt_topline() {
  local -a bg txt
  bg+=("$_PROMPT_HOST"); txt+=(" fi@%m ")
  bg+=("$_PROMPT_PATH"); txt+=(" $(_prompt_pwd) ")   # add ${_IC_FOLDER} here for a folder icon

  [[ -n "$VIRTUAL_ENV" ]] && { bg+=("$_PROMPT_VENV"); txt+=(" ${_IC_PYTHON} ${VIRTUAL_ENV:t} "); }

  local b=$(parse_git_branch)
  if [[ -n "$b" ]]; then
    local d="" gbg=$_PROMPT_GIT
    [[ -n $(git status --porcelain 2>/dev/null) ]] && { d="*"; gbg=$_PROMPT_DIRTY; }
    bg+=("$gbg"); txt+=(" ${_IC_BRANCH} ${b}${d} ")
  fi

  local out="" prev="" i
  for (( i=1; i<=${#bg}; i++ )); do
    if [[ -z "$prev" ]]; then
      out+="%K{${bg[i]}}%F{$_PROMPT_FG}${txt[i]}"
    else
      out+="%F{$prev}%K{${bg[i]}}${_PL}%F{$_PROMPT_FG}${txt[i]}"
    fi
    prev="${bg[i]}"
  done
  out+="%k%F{$prev}${_PL}%f"
  print -Pn "$out"
}

# --- input line: optional duration, then arrow (green ok / red ✘ + code) ---
_prompt_char() {
  local out=""
  (( _PROMPT_DUR > 5 )) && out+="%F{$_PROMPT_MUTED}${_IC_TIMER} ${_PROMPT_DUR}s  %f"
  if [[ $_PROMPT_STATUS -eq 0 || $_PROMPT_STATUS -eq 130 ]]; then
    out+="%F{$_PROMPT_OK}→%f"
  else
    out+="%F{$_PROMPT_ERR}✘ ${_PROMPT_STATUS}%f"
  fi
  print -Pn "$out"
}

# --- alternate: simple two-line prompt (no powerline) ---
_prompt_simple_line() {
  local b=$(parse_git_branch) out
  out="%F{$_PROMPT_MUTED}fi at %F{#85b7eb}%m%F{$_PROMPT_MUTED} in %F{#97c459}$(_prompt_pwd)"
  if [[ -n "$b" ]]; then
    local d=""; [[ -n $(git status --porcelain 2>/dev/null) ]] && d="*"
    out+="%F{$_PROMPT_MUTED} on %F{#ef9f27}${b}${d}"
  fi
  print -Pn "$out%f"
}
_prompt_simple_char() { [[ $_PROMPT_STATUS -eq 0 ]] && print -Pn "%F{$_PROMPT_OK}→%f" || print -Pn "%F{$_PROMPT_ERR}→%f"; }

# --- prompt: fatty ---
setopt PROMPT_SUBST
PROMPT_POWERLINE='$(_prompt_topline)
$(_prompt_char) '
# PROMPT=$PROMPT_POWERLINE

# --- prompt: simple ---
PROMPT_SIMPLE='$(_prompt_simple_line)
$(_prompt_simple_char) '
PROMPT=$PROMPT_SIMPLE

# =============================================================================
# ---------------------------- plugins & tools --------------------------------
# =============================================================================
#  plugins & tools (order-sensitive ~ keep the sequence);
#  zoxide → fzf(owns ^R) → autosuggest → highlight(last) → substring(after)
# =============================================================================
# --- zoxide (smart `z` directory jumping) --- 
eval "$(zoxide init zsh)"                                   

# ---  fzf (fuzzy Ctrl+R history + Ctrl+T file search) --- 
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh    # fuzzy Ctrl+R / Ctrl+T

# --- autosuggestions ~ (greyed-out history hint; → to accept) --- 
source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#5f5e5a'

# --- syntax highlighting ~ (green = valid command, red = typo) --- 
source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source $(brew --prefix)/share/zsh-history-substring-search/zsh-history-substring-search.zsh
bindkey '^[[A' history-substring-search-up      # ↑
bindkey '^[[B' history-substring-search-down    # ↓
bindkey -M vicmd 'k' history-substring-search-up    # vi mode: k
bindkey -M vicmd 'j' history-substring-search-down  # vi mode: j
