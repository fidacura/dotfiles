# ~/.zshrc
# =============================================================================
#  homebrew ~ sets up PATH for everything below
# =============================================================================
eval "$(/opt/homebrew/bin/brew shellenv)"

# =============================================================================
# -------------------------------- path ---------------------------------------
# =============================================================================
# -- prepends --
export PATH="$HOME/.npm-global/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# -- apps --
export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
export PATH="/opt/homebrew/opt/postgresql@18/bin:$PATH"

# -- node/nvm --
export NVM_DIR="$HOME/.nvm"
source "$(brew --prefix nvm)/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# -- personal --
export BACKUP_FOLDER="$HOME/backup"
export PATH="$HOME/.bin:$PATH"

# =============================================================================
# ---------------------------- env & history ----------------------------------
# =============================================================================
# --- terminal / tools ---
export CLICOLOR=1
export LSCOLORS="ExGxFxdxCxegedabagacad"    # BSD ls (mostly moot now that ls=eza)
export EZA_COLORS="da=37:uu=37:xx=37"       # eza: date, user, punctuation = white
export VIRTUAL_ENV_DISABLE_PROMPT=1         # let the prompt draw venv, not Python

# --- history ---
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY                        # share history across tabs instantly
setopt HIST_IGNORE_ALL_DUPS                 # no duplicate entries
setopt HIST_IGNORE_SPACE                    # leading space hides a command from history
setopt HIST_REDUCE_BLANKS                   # trim surplus whitespace
setopt EXTENDED_HISTORY                     # timestamps
setopt INC_APPEND_HISTORY                   # write as you go

# =============================================================================
# ------------------------------ completion -----------------------------------
# =============================================================================
mkdir -p ~/.zsh/cache
autoload -Uz compinit
compinit -C                                 # -C skips the slow security scan

zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' completer _complete _match _approximate
zstyle ':completion:*:approximate:*' max-errors 1 numeric
zstyle ':completion:*:descriptions' format '%U%B%d%b%u'
zstyle ':completion:*:messages' format '%F{blue}%d%f'

# ---  caching --- 
zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path ~/.zsh/cache

# --- command-specific ---
zstyle ':completion:*:processes' command 'ps -u $USER -o pid,user,comm -w -w'
zstyle ':completion:*:*:kill:*' menu yes select
zstyle ':completion:*:kill:*' force-list always

# =============================================================================
