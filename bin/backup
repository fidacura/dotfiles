#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: backup FILE-OR-DIRECTORY" 1>&2
  exit 1
fi

source=${1%/}

if [[ ! -e $source ]]; then
  echo "backup: not found: $source" 1>&2
  exit 1
fi

backup_name="$source.backup.$(date +%Y-%m-%d-%H-%M-%S)"

echo "backing up $source to $backup_name"

cp -a "$source" "$backup_name"

echo "backup created"
