#!/usr/bin/env bash

set -euo pipefail

dry_run=false
if [[ ${1:-} == --dry-run ]]; then
  dry_run=true
fi

remove() {
  if [[ -e $1 ]]; then
    if $dry_run; then
      echo "would remove: $1"
    else
      echo "removing: $1"
      rm -rf "$1"
    fi
  fi
}

remove_matching() {
  if $dry_run; then
    find . -name "$1" -print
  else
    find . -name "$1" -exec rm -rf {} +
  fi
}

echo "cleaning up development files...$($dry_run && echo ' (dry run)')"

# node.js
remove node_modules
remove .yarn
remove .pnp
remove .pnp.js

# build output / caches
remove .parcel-cache
remove dist
remove build
remove .cache
remove .next
remove out
remove .nuxt
remove .output
remove .vite
remove .turbo
remove .swc
remove coverage
remove .nyc_output
remove storybook-static
remove .eslintcache

# python
remove_matching '*.pyc'
remove_matching '__pycache__'
remove_matching '*.egg-info'
remove .pytest_cache

# rust
remove target

# misc
remove_matching '.DS_Store'
remove Thumbs.db
remove_matching '*.tmp'
remove_matching '*.log'

if [[ -d .git ]]; then
  if $dry_run; then
    echo "would run: git gc --prune=now"
  else
    echo "running git gc..."
    git gc --prune=now
  fi
fi

echo "cleanup complete"
