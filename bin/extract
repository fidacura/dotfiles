#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: extract ARCHIVE" 1>&2
  echo "supports: tar, tar.gz, tar.bz2, tar.xz, zip, rar, 7z, gz, bz2, Z" 1>&2
  exit 1
fi

file=$1

if [[ ! -f $file ]]; then
  echo "extract: file not found: $file" 1>&2
  exit 1
fi

echo "extracting: $file"

case $file in
  *.tar.bz2|*.tbz2) tar xjf "$file" ;;
  *.tar.gz|*.tgz)   tar xzf "$file" ;;
  *.tar.xz)         tar xJf "$file" ;;
  *.tar)            tar xf "$file" ;;
  *.bz2)            bunzip2 -k "$file" ;;
  *.gz)             gunzip -k "$file" ;;
  *.Z)              uncompress "$file" ;;
  *.zip)            unzip "$file" ;;
  *.rar)            unrar x "$file" ;;
  *.7z)             7z x "$file" ;;
  *)
    echo "extract: unsupported archive format: $file" 1>&2
    exit 1
    ;;
esac

echo "extraction complete"
