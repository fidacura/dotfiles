#!/usr/bin/env python3

import argparse, json, sys

parser = argparse.ArgumentParser(description="format and validate json")
group = parser.add_mutually_exclusive_group()
group.add_argument('--pretty', '-p', action='store_true', help='pretty print with 2-space indentation')
group.add_argument('--compact', '-c', action='store_true', help='compact output, no whitespace')
group.add_argument('--validate', '-v', action='store_true', help='validate only, no output')
args = parser.parse_args()

try:
  parsed = json.loads(sys.stdin.read())
except json.JSONDecodeError as e:
  print(f"json: invalid json: {e}", file=sys.stderr)
  sys.exit(1)

if args.validate:
  sys.exit(0)

if args.compact:
  output = json.dumps(parsed, separators=(',', ':'))
else:
  output = json.dumps(parsed, indent=2 if args.pretty else None)

print(output)
