#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: mp3-quality FILE QUALITY" 1>&2
  echo "  QUALITY: 0-100, higher is better quality (larger file)" 1>&2
  exit 1
fi

file=$1
quality=$2

if [[ ! $quality =~ ^[0-9]+$ ]] || (( quality < 0 || quality > 100 )); then
  echo "mp3-quality: QUALITY must be an integer between 0 and 100" 1>&2
  exit 1
fi

if [[ ! -f $file ]]; then
  echo "mp3-quality: not a file: $file" 1>&2
  exit 1
fi

# LAME's -q:a scale is inverted (0 = best, 9 = worst), so flip it.
lame_quality=$(( (100 - quality) * 9 / 100 ))

ffmpeg -hide_banner -loglevel error -y \
  -i "$file" \
  -codec:a libmp3lame \
  -q:a "$lame_quality" \
  -map_metadata 0 \
  -id3v2_version 3 \
  -write_id3v1 1 \
  "${file%.*}.mp3"
