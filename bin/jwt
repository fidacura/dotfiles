#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: jwt TOKEN" 1>&2
  exit 1
fi

IFS='.' read -r header payload _ <<< "$1"

if [[ -z $header || -z $payload ]]; then
  echo "jwt: not a valid jwt: $1" 1>&2
  exit 1
fi

decode() {
  python3 -c "
import sys, base64, json
s = sys.argv[1]
s += '=' * (-len(s) % 4)
print(json.dumps(json.loads(base64.urlsafe_b64decode(s)), indent=2))
" "$1"
}

echo "header:"
decode "$header"
echo
echo "payload:"
decode "$payload"
