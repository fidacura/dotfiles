#!/usr/bin/env bash

set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "usage: encode TYPE STRING" 1>&2
  echo "types: url, base64, decode-url, decode-base64" 1>&2
  exit 1
fi

type=$1
string=$2

case $type in
  url)
    python3 -c "import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))" "$string"
    ;;
  decode-url)
    python3 -c "import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]))" "$string"
    ;;
  base64)
    printf '%s' "$string" | base64
    ;;
  decode-base64)
    printf '%s' "$string" | base64 -d
    ;;
  *)
    echo "encode: unknown type: $type" 1>&2
    exit 1
    ;;
esac
